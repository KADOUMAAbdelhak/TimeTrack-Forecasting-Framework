{
  "protocol_version": "neural-v2.0",
  "target": "machine-level CPU utilization",
  "machines": [
    "machine01",
    "machine02",
    "machine03",
    "machine04",
    "machine05",
    "machine06",
    "machine07"
  ],
  "future_leads": [1, 2, 4, 8, 16, 32, 64, 128],
  "lead_minutes": [0.705, 1.410, 2.819, 5.638, 11.276, 22.552, 45.104, 90.208],
  "feature_sets": ["F0_LOCAL", "F1_THROUGHPUT"],
  "context_lengths": [32, 64, 128],
  "seeds": [0, 1, 2],
  "outer_folds": 5,
  "inner_validation_fraction": 0.15,
  "training": {
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "batch_size": 256,
    "maximum_epochs": 50,
    "early_stopping_patience": 7,
    "loss": "MSE",
    "gradient_clip": 1.0,
    "target_standardization": false
  },
  "patchtst_optimizer": {
    "name": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001
  },
  "models": {
    "DLinear": {
      "moving_average_kernel": 25
    },
    "LSTM": {
      "hidden_size": 64,
      "layers": 2,
      "dropout": 0.1,
      "bidirectional": false
    },
    "TCN-v2": {
      "channels": [32, 32, 32, 32, 32, 32],
      "kernel_size": 3,
      "dilations": [1, 2, 4, 8, 16, 32],
      "convolutions_per_block": 2,
      "dropout": 0.1,
      "receptive_field": 253
    },
    "PatchTST": {
      "patch_length": 8,
      "stride": 4,
      "d_model": 64,
      "attention_heads": 4,
      "encoder_layers": 2,
      "feed_forward_dimension": 128,
      "dropout": 0.1,
      "tokenization": "channel-independent with fixed late output-head mixing"
    }
  }
}
